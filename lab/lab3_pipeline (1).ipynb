 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Lab 3: potok danych obrazowych (kod)\n",
    "Ten notebook zawiera **tylko kod i eksperymenty**. Sprawozdanie jest w osobnym pliku `REPORT.md`.\n",
    "Wyniki zapisują się do plików (`figures/`, `results/`, `dataset/`), z których korzysta sprawozdanie.\n",
    "\n",
    "**Zbiór:** mini-zbiór *ants vs bees* zbudowany przez losowe, zbalansowane próbkowanie publicznego podzbioru ImageNet (hosting: PyTorch). **Uruchom:** Runtime → Run all (potrzebny internet do pobrania ok. 45 MB)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import json\n",
    "import shutil\n",
    "import urllib.request\n",
    "import zipfile\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from PIL import Image\n",
    "from torch.utils.data import DataLoader, Subset\n",
    "from torchvision import datasets, transforms\n",
    "\n",
    "SEED = 0\n",
    "torch.manual_seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(\"PyTorch:\", torch.__version__, \"|\", device)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0. Konfiguracja"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "DATA_URL = \"https://download.pytorch.org/tutorial/hymenoptera_data.zip\"\n",
    "RAW_ROOT = Path(\"raw\")\n",
    "RAW_DIR = RAW_ROOT / \"hymenoptera_data\"\n",
    "OUT_ROOT = Path(\"dataset\")  # dataset/train/<klasa>, dataset/val/<klasa>\n",
    "FIG_DIR = Path(\"figures\")\n",
    "RES_DIR = Path(\"results\")\n",
    "\n",
    "N_PER_CLASS = {\"train\": 100, \"val\": 60}  # zbalansowany mini-zbiór\n",
    "IMG_EXT = {\".jpg\", \".jpeg\", \".png\"}\n",
    "IMG_SIZE = 64  # rozmiar obrazu po transformacji\n",
    "BATCH = 16\n",
    "EPOCHS = 40\n",
    "\n",
    "for d in (FIG_DIR, RES_DIR):\n",
    "    d.mkdir(exist_ok=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Budowa mini-zbioru w układzie ImageFolder\n",
    "Pobieramy surowy zbiór, a następnie **losowo (seed) wybieramy po tyle samo obrazów z każdej klasy** do `dataset/train` i `dataset/val`. Podział train/val pochodzi z oryginalnego zbioru (to osobne fotografie, a nie sąsiednie klatki wideo, więc nie ma przecieku między podziałami). Lista wybranych plików trafia do `manifest.csv`."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def download_raw():\n",
    "    if RAW_DIR.exists():\n",
    "        print(\"Surowe dane już są:\", RAW_DIR)\n",
    "        return\n",
    "    RAW_ROOT.mkdir(exist_ok=True)\n",
    "    zip_path = RAW_ROOT / \"hymenoptera_data.zip\"\n",
    "    print(\"Pobieranie:\", DATA_URL)\n",
    "    urllib.request.urlretrieve(DATA_URL, zip_path)\n",
    "    with zipfile.ZipFile(zip_path) as zf:\n",
    "        zf.extractall(RAW_ROOT)\n",
    "    assert RAW_DIR.exists(), \"po rozpakowaniu brak folderu hymenoptera_data\"\n",
    "\n",
    "\n",
    "download_raw()"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def build_mini_dataset(n_per_split, seed=SEED):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    rows, avail = [], []\n",
    "    for split, n in n_per_split.items():\n",
    "        for cls_dir in sorted((RAW_DIR / split).iterdir()):\n",
    "            if not cls_dir.is_dir():\n",
    "                continue\n",
    "            files = sorted(\n",
    "                p for p in cls_dir.iterdir() if p.suffix.lower() in IMG_EXT\n",
    "            )\n",
    "            k = min(n, len(files))\n",
    "            keep = sorted(rng.choice(len(files), size=k, replace=False))\n",
    "            out_dir = OUT_ROOT / split / cls_dir.name\n",
    "            out_dir.mkdir(parents=True, exist_ok=True)\n",
    "            avail.append(\n",
    "                {\n",
    "                    \"split\": split,\n",
    "                    \"klasa\": cls_dir.name,\n",
    "                    \"dostepne\": len(files),\n",
    "                    \"wybrane\": k,\n",
    "                }\n",
    "            )\n",
    "            for j in keep:\n",
    "                src = files[j]\n",
    "                with Image.open(src) as im:\n",
    "                    width, height = im.size\n",
    "                    mode = im.mode\n",
    "                shutil.copy2(src, out_dir / src.name)\n",
    "                rows.append(\n",
    "                    {\n",
    "                        \"file\": f\"{split}/{cls_dir.name}/{src.name}\",\n",
    "                        \"class\": cls_dir.name,\n",
    "                        \"split\": split,\n",
    "                        \"original_file\": str(src.relative_to(RAW_ROOT)),\n",
    "                        \"width\": width,\n",
    "                        \"height\": height,\n",
    "                        \"mode\": mode,\n",
    "                    }\n",
    "                )\n",
    "    return pd.DataFrame(rows), pd.DataFrame(avail)\n",
    "\n",
    "\n",
    "if OUT_ROOT.exists():\n",
    "    shutil.rmtree(OUT_ROOT)  # czysty start\n",
    "manifest, avail = build_mini_dataset(N_PER_CLASS)\n",
    "manifest.to_csv(OUT_ROOT / \"manifest.csv\", index=False)\n",
    "avail.to_csv(RES_DIR / \"sampling_summary.csv\", index=False)\n",
    "display(avail)\n",
    "print(f\"Mini-zbiór: {len(manifest)} obrazów w {OUT_ROOT}/\")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "sizes = (\n",
    "    manifest[[\"width\", \"height\"]]\n",
    "    .describe()\n",
    "    .loc[[\"min\", \"50%\", \"max\"]]\n",
    "    .round(0)\n",
    ")\n",
    "sizes.index = [\"min\", \"mediana\", \"max\"]\n",
    "sizes.to_csv(RES_DIR / \"original_sizes.csv\")\n",
    "print(\"Rozmiary oryginałów [px]:\")\n",
    "display(sizes)\n",
    "print(\"Tryby kolorów:\", manifest[\"mode\"].value_counts().to_dict())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Potok transformacji, ImageFolder i DataLoader\n",
    "Wariant ewaluacyjny: `Resize` (krótszy bok) + `CenterCrop` + `ToTensor` + `Normalize` (zachowuje proporcje, bez zniekształcenia). Wariant treningowy dodatkowo: odbicie poziome, obrót ±15°, `ColorJitter`. Augmentacja tylko na zbiorze treningowym."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "MEAN, STD = [0.5] * 3, [0.5] * 3\n",
    "base_tf = [transforms.Resize(IMG_SIZE), transforms.CenterCrop(IMG_SIZE)]\n",
    "norm_tf = [transforms.ToTensor(), transforms.Normalize(MEAN, STD)]\n",
    "\n",
    "eval_tf = transforms.Compose(base_tf + norm_tf)\n",
    "train_tf = transforms.Compose(\n",
    "    base_tf\n",
    "    + [\n",
    "        transforms.RandomHorizontalFlip(),\n",
    "        transforms.RandomRotation(15),\n",
    "        transforms.ColorJitter(brightness=0.2, contrast=0.2),\n",
    "    ]\n",
    "    + norm_tf\n",
    ")\n",
    "\n",
    "train_ds = datasets.ImageFolder(OUT_ROOT / \"train\", transform=train_tf)\n",
    "val_ds = datasets.ImageFolder(OUT_ROOT / \"val\", transform=eval_tf)\n",
    "assert train_ds.class_to_idx == val_ds.class_to_idx, \"różne mapowanie klas!\"\n",
    "classes = train_ds.classes\n",
    "\n",
    "gen = torch.Generator().manual_seed(SEED)\n",
    "train_loader = DataLoader(\n",
    "    train_ds, batch_size=BATCH, shuffle=True, generator=gen, num_workers=2\n",
    ")\n",
    "val_loader = DataLoader(val_ds, batch_size=BATCH, shuffle=False)\n",
    "print(\"class_to_idx:\", train_ds.class_to_idx)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Statystyki zbioru"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "rows = []\n",
    "for split, ds in [(\"train\", train_ds), (\"val\", val_ds)]:\n",
    "    counts = np.bincount(ds.targets, minlength=len(classes))\n",
    "    for cls, n in zip(classes, counts):\n",
    "        rows.append({\"split\": split, \"klasa\": cls, \"obrazy\": int(n)})\n",
    "stats = pd.DataFrame(rows).pivot(\n",
    "    index=\"klasa\", columns=\"split\", values=\"obrazy\"\n",
    ")\n",
    "stats[\"razem\"] = stats.sum(axis=1)\n",
    "display(stats)\n",
    "stats.to_csv(RES_DIR / \"dataset_stats.csv\")\n",
    "\n",
    "# paczka z tasowaniem, żeby w podglądzie były obie klasy\n",
    "preview_loader = DataLoader(\n",
    "    val_ds,\n",
    "    batch_size=BATCH,\n",
    "    shuffle=True,\n",
    "    generator=torch.Generator().manual_seed(SEED),\n",
    ")\n",
    "xb, yb = next(iter(preview_loader))\n",
    "info = {\n",
    "    \"liczba_klas\": len(classes),\n",
    "    \"class_to_idx\": train_ds.class_to_idx,\n",
    "    \"rozmiar_po_transformacji\": list(xb.shape[1:]),\n",
    "    \"dtype\": str(xb.dtype),\n",
    "    \"zakres_wartosci\": [round(xb.min().item(), 2), round(xb.max().item(), 2)],\n",
    "    \"balans_train_min_max\": [\n",
    "        int(stats[\"train\"].min()),\n",
    "        int(stats[\"train\"].max()),\n",
    "    ],\n",
    "    \"balans_val_min_max\": [int(stats[\"val\"].min()), int(stats[\"val\"].max())],\n",
    "}\n",
    "json.dump(info, open(RES_DIR / \"dataset_info.json\", \"w\"), indent=2)\n",
    "print(json.dumps(info, indent=2, ensure_ascii=False))\n",
    "print(\"Paczka:\", tuple(xb.shape), \"| etykiety:\", yb.tolist())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Siatka przykładów z paczki i podgląd augmentacji"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def denorm(t):\n",
    "    # odwrócenie normalizacji do podglądu: x * std + mean\n",
    "    return (t * 0.5 + 0.5).clamp(0, 1).permute(1, 2, 0).numpy()\n",
    "\n",
    "\n",
    "n_show = min(16, len(xb))\n",
    "fig, axes = plt.subplots(2, 8, figsize=(14, 4))\n",
    "for ax in axes.flat:\n",
    "    ax.axis(\"off\")\n",
    "for ax, img, lb in zip(axes.flat, xb[:n_show], yb[:n_show]):\n",
    "    ax.imshow(denorm(img))\n",
    "    ax.set_title(classes[lb], fontsize=8)\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIG_DIR / \"batch_grid.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "path0, label0 = train_ds.samples[0]\n",
    "raw = Image.open(path0).convert(\"RGB\")\n",
    "fig, axes = plt.subplots(1, 6, figsize=(14, 2.8))\n",
    "axes[0].imshow(raw)\n",
    "axes[0].set_title(\"oryginał\", fontsize=8)\n",
    "for ax in axes[1:]:\n",
    "    ax.imshow(denorm(train_tf(raw)))\n",
    "    ax.set_title(\"augmentacja\", fontsize=8)\n",
    "for ax in axes:\n",
    "    ax.axis(\"off\")\n",
    "fig.suptitle(\n",
    "    f\"Ten sam obraz, klasa: {classes[label0]} (etykieta bez zmian)\", fontsize=9\n",
    ")\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIG_DIR / \"augmentation_preview.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Zakres dodatkowy: MLP na własnym mini-zbiorze\n",
    "Obrazy są spłaszczane (`Flatten`), liczba wyjść = liczba klas. Augmentacja tylko w treningu, walidacja na osobnym zbiorze `val`."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class MLP(nn.Module):\n",
    "    def __init__(self, in_dim, n_classes, hidden=(256, 128), p_drop=0.3):\n",
    "        super().__init__()\n",
    "        layers, d = [nn.Flatten()], in_dim\n",
    "        for h in hidden:\n",
    "            layers += [nn.Linear(d, h), nn.ReLU(), nn.Dropout(p_drop)]\n",
    "            d = h\n",
    "        layers.append(nn.Linear(d, n_classes))\n",
    "        self.net = nn.Sequential(*layers)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.net(x)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate(model, dl):\n",
    "    model.eval()\n",
    "    crit = nn.CrossEntropyLoss(reduction=\"sum\")\n",
    "    loss_sum, correct, total = 0.0, 0, 0\n",
    "    for xb_, yb_ in dl:\n",
    "        xb_, yb_ = xb_.to(device), yb_.to(device)\n",
    "        out = model(xb_)\n",
    "        loss_sum += crit(out, yb_).item()\n",
    "        correct += (out.argmax(1) == yb_).sum().item()\n",
    "        total += yb_.numel()\n",
    "    return loss_sum / total, correct / total\n",
    "\n",
    "\n",
    "def train_mlp(ds_train, epochs=EPOCHS, seed=SEED):\n",
    "    torch.manual_seed(seed)\n",
    "    gen_ = torch.Generator().manual_seed(seed)\n",
    "    loader = DataLoader(\n",
    "        ds_train,\n",
    "        batch_size=BATCH,\n",
    "        shuffle=True,\n",
    "        generator=gen_,\n",
    "        num_workers=2,\n",
    "    )\n",
    "    model = MLP(3 * IMG_SIZE * IMG_SIZE, len(classes)).to(device)\n",
    "    opt = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
    "    crit = nn.CrossEntropyLoss()\n",
    "    hist = {\"train_loss\": [], \"val_loss\": [], \"val_acc\": []}\n",
    "    for _ in range(epochs):\n",
    "        model.train()\n",
    "        run = 0.0\n",
    "        for xb_, yb_ in loader:\n",
    "            xb_, yb_ = xb_.to(device), yb_.to(device)\n",
    "            opt.zero_grad()\n",
    "            loss = crit(model(xb_), yb_)\n",
    "            loss.backward()\n",
    "            opt.step()\n",
    "            run += loss.item() * yb_.numel()\n",
    "        val_loss, val_acc = evaluate(model, val_loader)\n",
    "        hist[\"train_loss\"].append(run / len(loader.dataset))\n",
    "        hist[\"val_loss\"].append(val_loss)\n",
    "        hist[\"val_acc\"].append(val_acc)\n",
    "    return model, hist\n",
    "\n",
    "\n",
    "model, hist = train_mlp(train_ds)\n",
    "n_params = sum(p.numel() for p in model.parameters())\n",
    "print(model)\n",
    "print(\"Parametry:\", f\"{n_params:,}\")\n",
    "print(\n",
    "    f\"Epoka {EPOCHS}: val loss {hist['val_loss'][-1]:.3f}, \"\n",
    "    f\"val acc {hist['val_acc'][-1] * 100:.1f}%\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "ep = range(1, EPOCHS + 1)\n",
    "best_ep = int(np.argmin(hist[\"val_loss\"])) + 1\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(11, 3.8))\n",
    "ax1.plot(ep, hist[\"train_loss\"], \"--\", label=\"trening (z augmentacją)\")\n",
    "ax1.plot(ep, hist[\"val_loss\"], label=\"walidacja\")\n",
    "ax1.axvline(best_ep, color=\"gray\", ls=\"--\", lw=0.8)\n",
    "ax1.set_xlabel(\"epoka\")\n",
    "ax1.set_ylabel(\"strata (CE)\")\n",
    "ax1.legend(fontsize=8)\n",
    "ax2.plot(ep, [a * 100 for a in hist[\"val_acc\"]], color=\"green\")\n",
    "ax2.set_xlabel(\"epoka\")\n",
    "ax2.set_ylabel(\"accuracy walidacyjna [%]\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIG_DIR / \"mlp_curves.png\", dpi=150)\n",
    "plt.show()\n",
    "\n",
    "model.eval()\n",
    "preds, trues, imgs = [], [], []\n",
    "with torch.no_grad():\n",
    "    for xb_, yb_ in val_loader:\n",
    "        preds += model(xb_.to(device)).argmax(1).cpu().tolist()\n",
    "        trues += yb_.tolist()\n",
    "        imgs += list(xb_)\n",
    "sel = np.random.default_rng(SEED).choice(\n",
    "    len(imgs), min(12, len(imgs)), replace=False\n",
    ")\n",
    "fig, axes = plt.subplots(2, 6, figsize=(13, 5))\n",
    "for ax in axes.flat:\n",
    "    ax.axis(\"off\")\n",
    "for ax, j in zip(axes.flat, sel):\n",
    "    ax.imshow(denorm(imgs[j]))\n",
    "    ok = preds[j] == trues[j]\n",
    "    ax.set_title(\n",
    "        f\"pred: {classes[preds[j]]}\\nprawda: {classes[trues[j]]}\",\n",
    "        fontsize=8,\n",
    "        color=\"green\" if ok else \"red\",\n",
    "    )\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIG_DIR / \"mlp_predictions.png\", dpi=150)\n",
    "plt.show()\n",
    "\n",
    "mlp_res = {\n",
    "    \"architektura\": \"Flatten-256-128-%d (ReLU, dropout 0.3)\" % len(classes),\n",
    "    \"parametry\": n_params,\n",
    "    \"epoki\": EPOCHS,\n",
    "    \"val_acc_ostatnia_epoka\": round(hist[\"val_acc\"][-1] * 100, 2),\n",
    "    \"val_acc_w_epoce_min_val_loss\": round(\n",
    "        hist[\"val_acc\"][best_ep - 1] * 100, 2\n",
    "    ),\n",
    "    \"epoka_min_val_loss\": best_ep,\n",
    "    \"val_obrazy\": len(val_ds),\n",
    "}\n",
    "json.dump(mlp_res, open(RES_DIR / \"mlp_results.json\", \"w\"), indent=2)\n",
    "print(json.dumps(mlp_res, indent=2, ensure_ascii=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Zakres dodatkowy: wpływ liczby obrazów treningowych\n",
    "Ten sam MLP trenowany na coraz mniejszym, zbalansowanym podzbiorze treningowym (walidacja bez zmian). Pokazuje ograniczenia małego zbioru."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "targets = np.array(train_ds.targets)\n",
    "rng = np.random.default_rng(SEED)\n",
    "max_n = int(np.bincount(targets).min())\n",
    "rows = []\n",
    "for n in sorted({10, 25, 50, max_n}):\n",
    "    idx = []\n",
    "    for c in range(len(classes)):\n",
    "        pool = np.where(targets == c)[0]\n",
    "        idx += rng.choice(pool, size=min(n, len(pool)), replace=False).tolist()\n",
    "    _, h = train_mlp(Subset(train_ds, idx))\n",
    "    i = int(np.argmin(h[\"val_loss\"]))\n",
    "    rows.append(\n",
    "        {\n",
    "            \"obrazy_na_klase\": n,\n",
    "            \"val_acc_ostatnia [%]\": round(h[\"val_acc\"][-1] * 100, 2),\n",
    "            \"val_acc_min_val_loss [%]\": round(h[\"val_acc\"][i] * 100, 2),\n",
    "            \"min_val_loss\": round(h[\"val_loss\"][i], 3),\n",
    "        }\n",
    "    )\n",
    "size_df = pd.DataFrame(rows)\n",
    "size_df.to_csv(RES_DIR / \"train_size_effect.csv\", index=False)\n",
    "display(size_df)\n",
    "\n",
    "plt.figure(figsize=(5.5, 3.8))\n",
    "plt.plot(size_df[\"obrazy_na_klase\"], size_df[\"val_acc_ostatnia [%]\"], \"o-\")\n",
    "plt.xlabel(\"obrazów treningowych na klasę\")\n",
    "plt.ylabel(\"val accuracy [%]\")\n",
    "plt.title(\"Wpływ rozmiaru zbioru treningowego\")\n",
    "plt.grid(alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIG_DIR / \"train_size_effect.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
